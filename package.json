{
  "name": "showboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.electron.json",
    "electron:build": "node scripts/build-electron.mjs",
    "electron:dev": "npm run electron:build && concurrently -k -n vite,electron \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:start": "electron .",
    "package:mac": "npm run build && npm run electron:build && electron-builder --mac"
  },
  "dependencies": {
    "emoji-picker-react": "^4.19.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "com.seattlecomedytheater.showboard",
    "productName": "Showboard",
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dir",
      "identity": null,
      "icon": "build/icon.icns",
      "category": "public.app-category.entertainment"
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  }
}
